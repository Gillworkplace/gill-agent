# ============================================================================
# Gill Agent 本地环境配置模板（deploy/setup.sh 会交互式询问并生成 .env）
# 带默认值的项可直接回车；标记 <必填> 的必须提供；标记 <自动> 的留空自动生成
# ============================================================================

# ---- LLM（<必填>）----
ZHIPU_API_KEY=                        # 智谱 API Key（仅 agentd 使用，不进前端）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.6                   # 对话模型
ZHIPU_EMBED_MODEL=embedding-3         # 知识库向量模型

# ---- 沙箱（CubeSandbox 沙箱机）----
E2B_API_URL=http://39.107.34.109:3000
E2B_API_KEY=e2b_00000000000000000000000000000   # Cube 未开鉴权时的占位；开启后替换
CUBE_TEMPLATE_ID=gill-browser
CUBE_PROXY_NODE_IP=39.107.34.109

# ---- 知识库（可选覆盖默认）----
KB_INJECT_MAX=8                       # 每任务注入条数上限
KB_DEDUP_SIM=0.92                     # 去重相似度阈值
KB_INJECT_TOKENS=2000                 # 注入 token 预算

# ---- 协作空间（可选覆盖默认）----
SPACE_MEMBER_MAX=50                   # 每空间成员上限
SESSION_VIEWERS_MAX=10                # 同会话在线观看上限

# ---- 中间件（<自动>：留空则 setup.sh 生成随机值）----
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=gill-files
BACKUP_BUCKET=gill-backup

# ---- web ----
JWT_SECRET=                           # <自动> ≥32 字节随机
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=                  # <自动>（首次启动创建，日志不回显，可在后台重置）

# ---- 网络 ----
HTTP_PROXY_HOST=host.docker.internal  # 宿主机代理（构建/外网拉取用）
PROXY_PORT=7890
NO_EXTRA=no                           # no=使用上面代理；yes=完全不用代理（内网直连环境）

# ---- 镜像仓库（ACR，推送模板/应用镜像用；留空跳过推送）----
ACR_REGISTRY=registry.cn-guangzhou.aliyuncs.com
ACR_NAMESPACE=gill-gplatform
ACR_REPO=gill-agent-sandbox
ACR_USERNAME=
ACR_PASSWORD=
